# Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials

# Enable Supabase (set to "true" to use Supabase, "false" to use local PostgreSQL)
USE_SUPABASE=true

# Supabase Project URL (from your Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (from your Supabase dashboard - API Settings)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (from your Supabase dashboard - API Settings)
# This key bypasses RLS and should be kept secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Database Password (from your Supabase dashboard - Database Settings)
# This is used for direct PostgreSQL connections via SQLAlchemy
SUPABASE_DB_PASSWORD=your-db-password-here

# Optional: If you want to override the default database URL construction
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Existing configuration (keep these for fallback)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/insighteye
# REDIS_URL=redis://localhost:6379

# API Keys (keep your existing values)
OPENROUTER_API_KEY=your-openrouter-key
SIMILARWEB_API_KEY=your-similarweb-key
AHREFS_API_KEY=your-ahrefs-key
GOOGLE_ANALYTICS_CLIENT_ID=your-ga-client-id

# Auth0 Configuration (for hybrid auth or migration)
AUTH0_DOMAIN=your-auth0-domain
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Security
SECRET_KEY=your-secret-key-here

# Celery (Redis still needed for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0